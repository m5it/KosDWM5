import re
from pathlib import Path

def check_error_handling(file_path):
    '''Check error handling patterns in Python file.'''
    try:
        with open(file_path, 'r') as f:
            content = f.read()
        
        # Count error handling patterns
        try_count = len(re.findall(r'\btry\b:', content))
        except_count = len(re.findall(r'\bexcept\b', content))
        raise_count = len(re.findall(r'\braise\b', content))
        bare_except = len(re.findall(r'except\s*:', content))  # bare except (bad)
        
        # Check for print statements in except blocks
        print_in_except = len(re.findall(r'except[^:]*:[^\n]*\n[^\n]*print\(', content, re.DOTALL))
        
        return {
            'try': try_count,
            'except': except_count,
            'raise': raise_count,
            'bare_except': bare_except,
            'print_in_except': print_in_except
        }
    except Exception as e:
        return {'error': str(e)}

files = [
    'src/gadgets.py',
    'src/notices_store.py',
    'src/notifications.py',
    'src/notices_api.py'
]

print('Error handling analysis:')
print('=' * 60)

for f in files:
    if Path(f).exists():
        result = check_error_handling(f)
        print(f'\n{f}:')
        for k, v in result.items():
            print(f'  {k}: {v}')
