import ast
import sys
from pathlib import Path

def check_imports(file_path):
    '''Check for unused imports in a Python file.'''
    try:
        with open(file_path, 'r') as f:
            tree = ast.parse(f.read())
        
        # Get all imports
        imports = []
        used_names = set()
        
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                for alias in node.names:
                    imports.append(alias.name)
            elif isinstance(node, ast.ImportFrom):
                module = node.module or ''
                for alias in node.names:
                    name = alias.asname or alias.name
                    imports.append(f'{module}.{alias.name}')
            
            # Check for name usage (simple check)
            elif isinstance(node, ast.Name):
                used_names.add(node.id)
        
        return imports, used_names
    except SyntaxError as e:
        return [], set()

# Check main source files
src_files = [
    'src/gadgets.py',
    'src/notices_store.py', 
    'src/notices_api.py',
    'src/notifications.py',
    'src/version.py'
]

print('Checking imports in source files...')
for file_path in src_files:
    if Path(file_path).exists():
        imports, used = check_imports(file_path)
        print(f'\n{file_path}:')
        print(f'  Imports: {len(imports)}')
        print(f'  Sample: {imports[:3] if imports else "None"}')
