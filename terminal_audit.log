import re
from pathlib import Path

def find_hardcoded_paths(directory):
    '''Find hardcoded paths in Python files.'''
    patterns = [
        r'Path\.home\(\)',
        r'\.config/',
        r'\"/home/',
        r'\"/usr/',
        r'\"/opt/',
        r'os\.path\.expanduser',
        r'__file__',
    ]
    
    results = []
    
    for py_file in Path(directory).rglob('*.py'):
        try:
            with open(py_file, 'r') as f:
                content = f.read()
            
            for i, line in enumerate(content.split('\n'), 1):
                for pattern in patterns:
                    if re.search(pattern, line):
                        results.append((str(py_file), i, line.strip()))
                        break
        except Exception:
            pass
    
    return results

print('Searching for hardcoded paths in src/...')
results = find_hardcoded_paths('src')

if results:
    print(f'\nFound {len(results)} potential hardcoded paths:\n')
    for file, line, text in results[:20]:  # Show first 20
        print(f'{file}:{line}')
        print(f'  {text[:80]}')
        print()
else:
    print('No hardcoded paths found')
